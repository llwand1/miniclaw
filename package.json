{
  "name": "studentbuddy",
  "version": "0.1.0",
  "description": "studentbuddy - 纯 Web AI 助手（浏览器访问）",
  "scripts": {
    "build": "node scripts/build.js",
    "web": "tsx scripts/dev-server.ts",
    "web:dev": "concurrently -n api,ui \"tsx scripts/dev-server.ts\" \"cd src/office-web && node_modules\\.bin\\vite.cmd\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:daily": "node scripts/daily-test.cjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
